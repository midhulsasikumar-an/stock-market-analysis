# Backend API URL — all market data calls go through your Express server
REACT_APP_API_URL=http://localhost:5000

# Google OAuth (for frontend Google Sign-In button)
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# NOTE: REACT_APP_FINNHUB_API_KEY has been intentionally removed.
# All Finnhub and Alpha Vantage calls are now proxied through the backend.
# API keys live in Backend_/.env only.